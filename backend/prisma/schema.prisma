generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts     Account[]
  owners       Owner[]
  categories   Category[]
  transactions Transaction[]
  transfers    Transfer[]
  auditLogs    AuditLog[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  name      String             // e.g. "BOB", "IOB"
  bankName  String?            // e.g. "Bank of Baroda"
  type      String             // savings | current | cash | credit | wallet
  currency  String  @default("INR")
  isDefault Boolean @default(false)   // seeded suggestion vs user-created
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  transfersFrom  Transfer[]    @relation("TransferFrom")
  transfersTo    Transfer[]    @relation("TransferTo")

  @@unique([userId, name])
  @@index([userId])
}

model Owner {
  id        String   @id @default(cuid())
  userId    String
  name      String             // ME, DAD, MOM, FAMILY
  color     String?            // hex for UI display
  isDefault Boolean @default(false)   // seeded suggestion vs user-created
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  transfers    Transfer[]

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String             // income | expense
  icon      String?
  isDefault Boolean @default(false)   // seeded suggestion vs user-created
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(15, 2)
  type        String             // income | expense | received
  description String?
  date        DateTime
  accountId   String
  ownerId     String
  categoryId  String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account  Account  @relation(fields: [accountId], references: [id])
  owner    Owner    @relation(fields: [ownerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]

  @@index([accountId])
  @@index([ownerId])
  @@index([userId])
  @@index([date])
}

model Transfer {
  id            String   @id @default(cuid())
  amount        Decimal  @db.Decimal(15, 2)
  fromAccountId String
  toAccountId   String
  ownerId       String
  userId        String
  description   String?
  date          DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id])
  owner       Owner   @relation(fields: [ownerId], references: [id])
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model AuditLog {
  id            String   @id @default(cuid())
  transactionId String
  userId        String
  field         String
  oldValue      String?
  newValue      String?
  changedAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([userId])
}
